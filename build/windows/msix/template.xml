<?xml version="1.0" encoding="utf-8"?>
<MsixPackagingToolTemplate
    xmlns="http://schemas.microsoft.com/msix/packaging/msixpackagingtool/template/2022">
    <Settings
        AllowTelemetry="false"
        ApplyACLsToPackageFiles="true"
        GenerateCommandLineFile="true"
        AllowPromptForPassword="false">
    </Settings>
    <Installer
        Path="sage.exe"
        Arguments=""
        InstallLocation="C:\Program Files\t0ma5\sage">
    </Installer>
    <PackageInformation
        PackageName="sage"
        PackageDisplayName="sage"
        PublisherName="CN=t0ma5"
        PublisherDisplayName="t0ma5"
        Version="0.1.0.0"
        PackageDescription="Simple GUI for age file encryption">
        <Capabilities>
            <Capability Name="runFullTrust" />
            
        </Capabilities>
        <Applications>
            <Application
                Id="io.github.t0ma5.sage"
                Description="Simple GUI for age file encryption"
                DisplayName="sage"
                ExecutableName="sage.exe"
                EntryPoint="Windows.FullTrustApplication">
                
            </Application>
        </Applications>
        <Resources>
            <Resource Language="en-us" />
        </Resources>
        <Dependencies>
            <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.19041.0" />
        </Dependencies>
        <Properties>
            <Framework>false</Framework>
            <DisplayName>sage</DisplayName>
            <PublisherDisplayName>t0ma5</PublisherDisplayName>
            <Description>Simple GUI for age file encryption</Description>
            <Logo>Assets\AppIcon.png</Logo>
        </Properties>
    </PackageInformation>
    <SaveLocation PackagePath="sage.msix" />
    <PackageIntegrity>
        <CertificatePath></CertificatePath>
    </PackageIntegrity>
</MsixPackagingToolTemplate>
